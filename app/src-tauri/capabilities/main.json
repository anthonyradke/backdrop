{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The library window: every command",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-start-dragging",
    "core:window:allow-minimize",
    "core:window:allow-toggle-maximize",
    "core:window:allow-internal-toggle-maximize",
    "core:window:allow-close",
    "allow-get-state",
    "allow-import-paths",
    "allow-pick-files",
    "allow-save-thumb",
    "allow-rename-item",
    "allow-delete-items",
    "allow-set-wallpaper",
    "allow-cursor-position",
    "allow-audio-spectrum",
    "allow-now-playing",
    "allow-span-wallpaper",
    "allow-clear-wallpaper",
    "allow-update-settings",
    "allow-set-paused",
    "allow-set-autostart",
    "allow-open-library-dir",
    "allow-player-init",
    "allow-player-log",
    "allow-set-in-rotation",
    "allow-next-wallpaper",
    "allow-save-frame",
    "allow-reset-settings",
    "allow-workshop-browse",
    "allow-workshop-subscribed",
    "allow-workshop-subscribe",
    "allow-workshop-open",
    "allow-workshop-open-steam",
    "allow-workshop-add",
    "allow-workshop-hide",
    "allow-workshop-unhide-all",
    "allow-update-state",
    "allow-check-update",
    "allow-install-update",
    "allow-item-properties",
    "allow-set-item-properties",
    "allow-set-in-display-rotation",
    "allow-set-schedule",
    "allow-set-app-rules",
    "allow-running-apps",
    "allow-player-stats",
    "allow-convert-video",
    "allow-install-ffmpeg"
  ]
}
