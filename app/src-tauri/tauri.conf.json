{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Backdrop",
  "version": "0.5.0",
  "identifier": "com.anthonyradke.backdrop",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self'",
        "script-src": "'self' blob: 'unsafe-eval'",
        "worker-src": "blob:",
        "style-src": "'self' 'unsafe-inline'",
        "img-src": "'self' data: blob: https: http://media.localhost media: http://127.0.0.1:*",
        "media-src": "'self' data: blob: http://media.localhost media: http://127.0.0.1:*",
        "font-src": "'self' data: blob: http://media.localhost media:",
        "connect-src": "'self' ipc: http://ipc.localhost data: blob: http://media.localhost media:",
        "frame-src": "http://127.0.0.1:* http://media.localhost media:",
        "object-src": "'none'",
        "base-uri": "'none'"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "category": "Utility",
    "shortDescription": "Live wallpapers",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": { "installMode": "currentUser" }
    },
    "createUpdaterArtifacts": true
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEJDN0M4ODNBRTk5QzRGRDcKUldUWFQ1enBPb2g4dktrSXJXL3pRMkdLMVFMNWtmNFZVM2lZRnBsdHc1bHNqN3l2bGJFb09GOCsK",
      "endpoints": ["https://github.com/anthonyradke/backdrop/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
